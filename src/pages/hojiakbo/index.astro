---
import { Image } from 'astro:assets';
import Layout from '../../components/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';
import LiteYouTube from '../../components/LiteYouTube.astro';
import FbVideo from '../../components/FbVideo.astro';
import FbPost from '../../components/FbPost.astro';
import hoj from '../../data/hojiakbo.json';

// Optional hero banner: drop a file at src/assets/hojiakbo/<banner> to use it.
const banners = import.meta.glob<{ default: ImageMetadata }>(
  '../../assets/hojiakbo/*.{jpg,jpeg,png,webp,avif}',
  { eager: true },
);
const bannerMeta = banners[`../../assets/hojiakbo/${hoj.banner}`]?.default;

const favourites = hoj.favourites.filter((v) => v.id);
const stats = Object.entries(hoj.stats);
---

<Layout title="Hojiakbo">
  <PageHeader crumbs={[{ label: 'Emerson Ng', href: '' }, { label: 'Hojiakbo' }]} />

  {
    bannerMeta ? (
      <Image
        src={bannerMeta}
        alt="Hojiakbo, Grandpa and me"
        widths={[768, 1280, 2000]}
        sizes="100vw"
        class="banner"
      />
    ) : (
      <div class="banner-fallback">
        <h1>Hojiakbo<span class="dot">.</span></h1>
      </div>
    )
  }

  <section class="wrap story">
    <div class="story-text">
      {hoj.story.map((p) => <p>{p}</p>)}
    </div>
    <dl class="story-stats">
      {
        stats.map(([k, v]) => (
          <div>
            <dt>{k}</dt>
            <dd>{v}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  {
    favourites.length > 0 && (
      <section class="wrap block">
        <div class="block-head">
          <h2>Our favourites</h2>
          <a href={hoj.channel} target="_blank" rel="noopener noreferrer">Visit the channel →</a>
        </div>
        <div class="vid-grid">
          {favourites.map((v) => (
            <figure>
              <LiteYouTube id={v.id} title={v.title} />
              <figcaption>{v.title}</figcaption>
            </figure>
          ))}
        </div>
      </section>
    )
  }

  {
    hoj.featured.length > 0 && (
      <section class="wrap block">
        <div class="block-head">
          <h2>Featured</h2>
          {favourites.length === 0 && (
            <a href={hoj.channel} target="_blank" rel="noopener noreferrer">Visit the channel →</a>
          )}
        </div>
        <div class="card-grid">
          {hoj.featured.map((f) => {
            if ('fb' in f && f.fb) {
              return (
                <figure class="feat-vid">
                  <FbVideo href={f.fb} title={f.title} />
                  <figcaption><span class="feat-src">{f.source}</span> {f.title}</figcaption>
                </figure>
              );
            }
            if ('fbPost' in f && f.fbPost) {
              return (
                <figure class="feat-post">
                  <FbPost href={f.fbPost} title={f.title} />
                  <figcaption><span class="feat-src">{f.source}</span> {f.title}</figcaption>
                </figure>
              );
            }
            return (
              <a class="feat" href={f.href} target="_blank" rel="noopener noreferrer">
                <span class="feat-top">
                  <span class="feat-src">{f.source}</span>
                  <span class="feat-kind">{f.kind === 'reel' ? 'Reel' : 'Article'}</span>
                </span>
                <span class="feat-title">{f.title}</span>
                <span class="feat-go" aria-hidden="true">→</span>
              </a>
            );
          })}
        </div>
      </section>
    )
  }

  <section class="memory">
    <div class="wrap">
      <p class="memory-line">In memory of {hoj.memory.name}.</p>
      <p class="memory-years">{hoj.memory.years}</p>
    </div>
  </section>
</Layout>

<style>
  .banner { display: block; width: 100%; height: auto; }
  .banner-fallback {
    background: var(--dark);
    display: flex;
    align-items: flex-end;
    min-height: 320px;
    padding: 48px 32px;
  }
  .banner-fallback h1 {
    margin: 0;
    font-family: var(--serif);
    font-weight: 400;
    font-size: clamp(72px, 14vw, 168px);
    line-height: .84;
    letter-spacing: -.035em;
    color: var(--dark-ink);
  }
  .dot { color: var(--accent); }

  .story {
    display: flex;
    flex-wrap: wrap;
    gap: 48px 80px;
    padding-top: 88px;
    padding-bottom: 72px;
  }
  .story-text { flex: 2 1 520px; max-width: 720px; display: flex; flex-direction: column; gap: 22px; }
  .story-text p { margin: 0; font-size: 21px; line-height: 1.65; color: var(--ink-2); }
  .story-stats { flex: 1 1 220px; margin: 0; display: flex; flex-direction: column; gap: 24px; }
  .story-stats div { border-top: 1px solid var(--line); padding-top: 14px; }
  .story-stats dt { font-size: 14px; color: var(--muted); }
  .story-stats dd { margin: 4px 0 0; font-family: var(--serif); font-size: 44px; }

  .block { padding-bottom: 88px; }
  .block-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
    margin-bottom: 24px;
  }
  .block-head h2 { margin: 0; font-family: var(--serif); font-weight: 400; font-size: 48px; letter-spacing: -.02em; }
  .block-head a { font-weight: 600; padding: 12px 0; text-decoration: none; }

  .vid-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(340px, 1fr)); gap: 28px 20px; }
  .vid-grid figure { margin: 0; }
  .vid-grid figcaption { margin-top: 10px; font-size: 16px; font-weight: 600; }

  .card-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 16px; }
  .feat {
    display: flex;
    flex-direction: column;
    gap: 14px;
    min-height: 150px;
    padding: 22px;
    border-radius: 20px;
    background: var(--surface);
    border: 1px solid var(--line);
    color: var(--ink);
    text-decoration: none;
    transition: transform .2s ease, box-shadow .2s ease;
  }
  .feat:hover { transform: translateY(-4px); box-shadow: 0 12px 28px rgba(30, 28, 24, .12); color: var(--ink); }
  .feat-top { display: flex; align-items: center; justify-content: space-between; gap: 10px; }
  .feat-src { font-size: 14px; font-weight: 700; }
  .feat-kind { font-family: var(--mono); font-size: 12px; color: var(--muted); padding: 2px 10px; border-radius: 999px; background: var(--bg); }
  .feat-title { font-size: 20px; font-weight: 600; line-height: 1.25; letter-spacing: -.01em; }
  .feat-go { margin-top: auto; color: var(--accent); font-size: 20px; }

  .feat-vid { grid-column: 1 / -1; margin: 0; max-width: 720px; }
  .feat-post { grid-column: 1 / -1; margin: 0; }
  .feat-vid figcaption, .feat-post figcaption { margin-top: 10px; font-size: 16px; color: var(--ink-2); }
  .feat-vid .feat-src, .feat-post .feat-src { font-weight: 700; color: var(--ink); }

  .memory { border-top: 1px solid var(--line); }
  .memory .wrap { padding-top: 72px; padding-bottom: 120px; text-align: center; }
  .memory-line { margin: 0; font-family: var(--serif); font-size: 32px; line-height: 1.3; }
  .memory-years { margin: 10px 0 0; font-size: 16px; color: var(--muted); }

  @media (max-width: 760px) {
    .story { padding-top: 48px; gap: 32px; }
    .story-text p { font-size: 18px; }
    .block-head h2 { font-size: 36px; }
  }
  @media (prefers-reduced-motion: reduce) { .feat { transition: none; } }
</style>
