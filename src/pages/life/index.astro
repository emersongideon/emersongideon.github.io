---
import { getImage } from 'astro:assets';
import Layout from '../../components/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';
import { url } from '../../lib/url';
import life from '../../data/life.json';

const glob = import.meta.glob<{ default: ImageMetadata }>(
  '../../assets/life/*.{jpg,jpeg,png,webp,avif}',
  { eager: true },
);
const catById = Object.fromEntries(life.cats.map((c) => [c.id, c]));
const counts = Object.fromEntries(
  life.cats.map((c) => [c.id, life.events.filter((e) => e.cat === c.id).length]),
);

const events = await Promise.all(
  life.events.map(async (e) => {
    let img: { src: string; ratio: string } | null = null;
    if (e.photo) {
      const m = glob[`../../assets/life/${e.photo}`]?.default;
      if (m) {
        const g = await getImage({ src: m, width: 760, format: 'webp' });
        img = { src: g.src, ratio: (m.width / m.height).toFixed(3) };
      }
    }
    const cat = catById[e.cat];
    return { ...e, img, catLabel: cat?.label ?? e.cat, color: cat?.color ?? '#DAD6CE' };
  }),
);
---

<Layout title="Life">
  <PageHeader crumbs={[{ label: 'Emerson Ng', href: '' }, { label: 'Life' }]} />

  <section class="wrap hero">
    <h1>Life<span class="dot">.</span></h1>
    <p>{life.tagline}</p>
  </section>

  <section class="wrap filters" aria-label="Filters">
    <div class="filter-bar">
      <span class="show-me">SHOW ME</span>
      {
        life.cats.map((c) => (
          <button type="button" class="chip" data-cat={c.id} aria-pressed="true" style={`--c:${c.color}`}>
            <span class="dot-sm" />
            {c.label}
            <span class="cc">{counts[c.id]}</span>
          </button>
        ))
      }
      <span class="spacer" />
      <button type="button" id="chip-all" class="link-btn">All</button>
      <button type="button" id="chip-none" class="link-btn muted">Clear</button>
    </div>
  </section>

  <section class="wrap life-wrap" aria-label="Timeline">
    <div class="rows-col">
      <p class="empty" id="empty" hidden>Pick a filter. My life isn't that boring, promise.</p>
      <ol class="rows" id="rows">
        {
          events.map((e, i) => (
            <li
              class="row"
              data-cat={e.cat}
              data-i={i}
              data-photo={e.img?.src ?? ''}
              data-ratio={e.img?.ratio ?? ''}
              data-note={e.note}
              data-title={e.title}
              data-year={e.year}
              data-catlabel={e.catLabel}
              tabindex="0"
            >
              <span class="yr">{e.year}</span>
              <span class="node"><span class="line" /><span class="dot2" style={`background:${e.color}`} /></span>
              <span class="rbody">
                <span class="rtitle">{e.title}</span>
                <span class="pill" style={`background:${e.color}`}>{e.catLabel}</span>
                {e.anchor && <a class="rlink" href={url('countries/')}>on the map →</a>}
              </span>
              <div class="row-expand" hidden>
                {e.img
                  ? <img src={e.img.src} alt={e.title} style={`aspect-ratio:${e.img.ratio}`} loading="lazy" />
                  : <div class="exp-ph">[PHOTO]</div>}
                <p>{e.note}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>

    <aside class="panel" aria-hidden="true">
      <div class="panel-inner">
        <div class="panel-frame" id="panel-frame"><span class="panel-hint">Hover a moment</span></div>
        <p class="panel-meta" id="panel-meta"></p>
        <p class="panel-title" id="panel-title"></p>
        <p class="panel-note" id="panel-note">Every moment has a picture. Hover to see it.</p>
      </div>
    </aside>
  </section>
</Layout>

<style>
  .hero { padding-top: 40px; padding-bottom: 40px; }
  .hero h1 { margin: 0; font-family: var(--serif); font-weight: 400; font-size: clamp(88px, 16vw, 168px); line-height: .84; letter-spacing: -.035em; }
  .dot { color: var(--accent); }
  .hero p { margin: 24px 0 0; font-family: var(--serif); font-size: clamp(20px, 3vw, 28px); color: var(--ink-2); max-width: 760px; }

  .filters { padding-bottom: 40px; }
  .filter-bar { background: var(--surface); border: 1px solid var(--line); border-radius: 24px; padding: 20px; display: flex; flex-wrap: wrap; gap: 10px; align-items: center; }
  .show-me { font-family: var(--mono); font-size: 13px; color: var(--muted); margin-right: 6px; }
  .chip { display: inline-flex; align-items: center; gap: 8px; min-height: 44px; padding: 0 16px; border-radius: 999px; font: inherit; font-size: 15px; font-weight: 600; cursor: pointer; color: var(--ink); background: var(--surface); border: 2px solid var(--line); }
  .chip[aria-pressed='true'] { background: var(--c); border-color: var(--ink); }
  .dot-sm { width: 10px; height: 10px; border-radius: 50%; background: var(--c); }
  .chip[aria-pressed='true'] .dot-sm { background: var(--ink); }
  .cc { font-family: var(--mono); font-size: 12px; opacity: .7; }
  .spacer { flex: 1; }
  .link-btn { min-height: 44px; padding: 0 14px; border: 0; background: transparent; color: var(--accent); font: inherit; font-size: 15px; font-weight: 600; cursor: pointer; }
  .link-btn.muted { color: var(--muted); }

  .life-wrap { display: flex; gap: 32px; align-items: flex-start; padding-bottom: 120px; }
  .rows-col { flex: 1 1 auto; min-width: 0; }
  .rows { list-style: none; margin: 0; padding: 0; }
  .empty { margin: 40px 0; text-align: center; font-family: var(--serif); font-size: 26px; color: var(--muted); }

  .row { display: grid; grid-template-columns: 72px 28px minmax(0, 1fr); align-items: center; min-height: 52px; border-radius: 12px; outline-offset: 2px; }
  .yr { font-family: var(--mono); font-size: 14px; font-weight: 600; }
  .node { position: relative; align-self: stretch; }
  .node .line { position: absolute; left: 13px; top: 0; bottom: 0; width: 2px; background: var(--line); }
  .node .dot2 { position: absolute; left: 7px; top: calc(50% - 7px); width: 14px; height: 14px; border-radius: 50%; border: 2px solid var(--ink); box-sizing: border-box; }
  .rbody { display: flex; align-items: center; gap: 12px; min-width: 0; padding: 12px 16px; border-radius: 12px; }
  .rtitle { font-size: 18px; font-weight: 700; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .pill { flex: none; padding: 2px 10px; border-radius: 999px; font-size: 12px; font-weight: 600; }
  .rlink { flex: none; font-size: 13px; font-weight: 600; text-decoration: none; }
  .row:hover .rbody, .row:focus-visible .rbody { background: #fff; }

  .row-expand { grid-column: 1 / -1; padding: 0 16px 16px; }
  .row-expand img { width: 100%; border-radius: 14px; display: block; }
  .exp-ph { width: 100%; aspect-ratio: 4/3; border-radius: 14px; background: #DEDAD2; display: flex; align-items: center; justify-content: center; font-family: var(--mono); font-size: 12px; color: var(--muted); }
  .row-expand p { margin: 12px 0 0; font-size: 16px; line-height: 1.5; color: var(--ink-2); }

  .panel { flex: none; width: 380px; position: sticky; top: 84px; }
  .panel-frame { width: 100%; border-radius: 18px; overflow: hidden; background: #DEDAD2; border: 1px dashed #BDB8AE; aspect-ratio: 4/3; display: flex; align-items: center; justify-content: center; box-shadow: 0 14px 34px rgba(30, 28, 24, .12); }
  .panel-frame img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .panel-hint { font-family: var(--mono); font-size: 12px; color: var(--muted); }
  .panel-meta { margin: 16px 0 0; font-family: var(--mono); font-size: 13px; color: var(--muted); }
  .panel-title { margin: 6px 0 0; font-size: 24px; font-weight: 900; letter-spacing: -.02em; }
  .panel-note { margin: 8px 0 0; font-size: 16px; line-height: 1.5; color: var(--ink-2); }

  /* mobile: no side panel, rows expand inline */
  @media (max-width: 900px) {
    .panel { display: none; }
    .row { cursor: pointer; }
  }
  @media (max-width: 760px) {
    .rtitle { white-space: normal; }
  }
</style>

<script>
  const rows = Array.from(document.querySelectorAll<HTMLElement>('.row'));
  const chips = Array.from(document.querySelectorAll<HTMLButtonElement>('.chip'));
  const empty = document.getElementById('empty')!;
  const isMobile = () => matchMedia('(max-width: 900px)').matches;
  const finePointer = matchMedia('(hover: hover) and (pointer: fine)').matches;

  const active = new Set(chips.map((c) => c.dataset.cat!));

  function apply() {
    let shown = 0;
    rows.forEach((r) => {
      const on = active.has(r.dataset.cat!);
      r.hidden = !on;
      if (on) shown++;
    });
    chips.forEach((c) => c.setAttribute('aria-pressed', String(active.has(c.dataset.cat!))));
    empty.hidden = shown > 0;
  }

  chips.forEach((c) =>
    c.addEventListener('click', () => {
      const id = c.dataset.cat!;
      if (active.has(id)) active.delete(id);
      else active.add(id);
      apply();
    }),
  );
  document.getElementById('chip-all')!.addEventListener('click', () => {
    chips.forEach((c) => active.add(c.dataset.cat!));
    apply();
  });
  document.getElementById('chip-none')!.addEventListener('click', () => {
    active.clear();
    apply();
  });

  // Desktop: hover/focus swaps the fixed panel.
  const frame = document.getElementById('panel-frame')!;
  const meta = document.getElementById('panel-meta')!;
  const title = document.getElementById('panel-title')!;
  const note = document.getElementById('panel-note')!;
  function preview(r: HTMLElement) {
    const photo = r.dataset.photo;
    if (photo) {
      frame.innerHTML = '';
      const img = new Image();
      img.src = photo;
      img.alt = r.dataset.title ?? '';
      frame.style.aspectRatio = r.dataset.ratio || '4 / 3';
      frame.appendChild(img);
    } else {
      frame.style.aspectRatio = '4 / 3';
      frame.innerHTML = '<span class="panel-hint">[photo coming]</span>';
    }
    meta.textContent = `${r.dataset.year}, ${r.dataset.catlabel}`;
    title.textContent = r.dataset.title ?? '';
    note.textContent = r.dataset.note ?? '';
  }
  if (finePointer) {
    rows.forEach((r) => {
      r.addEventListener('mouseenter', () => preview(r));
      r.addEventListener('focus', () => preview(r));
    });
  }

  // Mobile: tap toggles the inline expansion.
  rows.forEach((r) => {
    r.addEventListener('click', () => {
      if (!isMobile()) return;
      const exp = r.querySelector<HTMLElement>('.row-expand')!;
      exp.hidden = !exp.hidden;
    });
  });

  apply();
</script>
