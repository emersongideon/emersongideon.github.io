---
import Layout from '../components/Layout.astro';
// Placeholder home for the first deploy. The real home (ported from index.html)
// lands in step 2.
---

<Layout title="Emerson Ng">
  <main class="wrap" style="min-height: 80vh; display: flex; flex-direction: column; justify-content: center; padding-top: 96px; padding-bottom: 96px;">
    <h1 style="margin: 0; font-family: var(--serif); font-weight: 400; font-size: clamp(84px, 14vw, 184px); line-height: .84; letter-spacing: -.035em;">
      Emerson<br />Ng.
    </h1>
    <p style="margin: 40px 0 0; max-width: 620px; font-size: clamp(20px, 3vw, 28px); font-weight: 600; letter-spacing: -.02em; line-height: 1.15;">
      A record of my life, under construction.
    </p>
    <p style="margin: 16px 0 0; color: var(--muted); font-family: var(--mono); font-size: 14px;">
      Deploy check: if you can read this on github.io, the pipeline works.
    </p>
  </main>
</Layout>
