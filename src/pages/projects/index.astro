---
import Layout from '../../components/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';
import { url } from '../../lib/url';
import p from '../../data/projects.json';
---

<Layout title="Side hustles">
  <PageHeader crumbs={[{ label: 'Emerson Ng', href: '' }, { label: 'Side hustles' }]} />

  <section class="wrap hero">
    <h1>Side<br />hustles<span class="dot">.</span></h1>
    <p>{p.tagline}</p>
  </section>

  <section class="wrap sec" id="cmdtempo">
    <div class="panel tint-made">
      <div class="panel-text">
        <p class="kicker">01, Code</p>
        <h2>{p.cmdtempo.name}</h2>
        <p class="blurb">{p.cmdtempo.blurb}</p>
        <a class="btn-dark" href={p.cmdtempo.href} target="_blank" rel="noopener noreferrer">Visit {p.cmdtempo.name} →</a>
      </div>
      <div class="term" aria-hidden="true">
        <div class="dots"><span></span><span></span><span></span></div>
        <div><span class="prompt">$</span> {p.cmdtempo.stack}</div>
        <div class="dim">{p.cmdtempo.status}</div>
      </div>
    </div>
  </section>

  <section class="wrap sec" id="data">
    <p class="kicker">02, Data journalism</p>
    <h2 class="sec-h">Data journalism</h2>
    <p class="sec-intro">{p.dataJournalism.intro}</p>
    <div class="dj-grid">
      {
        p.dataJournalism.pieces.map((d) => (
          <a class="dj" href={d.href} target="_blank" rel="noopener noreferrer">
            <span class="dj-tag">{d.tag}</span>
            <span class="dj-title">{d.title}</span>
            <span class="dj-blurb">{d.blurb}</span>
            <span class="dj-go" aria-hidden="true">Read →</span>
          </a>
        ))
      }
    </div>
  </section>

  <section class="wrap sec last" id="calefare">
    <div class="panel tint-cal">
      <div class="panel-text">
        <p class="kicker">03, On screen</p>
        <h2>Calefare work</h2>
        <p class="blurb">{p.calefareTeaser.blurb}</p>
        <a class="btn-dark" href={url('calefare/')}>Spot me in the reel →</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .hero { padding-top: 40px; padding-bottom: 56px; }
  .hero h1 { margin: 0; font-family: var(--serif); font-weight: 400; font-size: clamp(80px, 13vw, 152px); line-height: .86; letter-spacing: -.035em; }
  .dot { color: var(--accent); }
  .hero p { margin: 24px 0 0; font-family: var(--serif); font-size: clamp(20px, 3vw, 28px); color: var(--ink-2); }

  .sec { padding-bottom: 24px; scroll-margin-top: 80px; }
  .sec.last { padding-bottom: 120px; }
  .kicker { margin: 0; font-family: var(--mono); font-size: 13px; font-weight: 600; letter-spacing: .1em; text-transform: uppercase; }

  .panel { border-radius: 32px; padding: 48px; display: flex; flex-wrap: wrap; gap: 40px; align-items: center; }
  .tint-made { background: #E9E4D2; }
  .tint-cal { background: #E9DCDF; }
  .panel-text { flex: 1 1 400px; }
  .panel-text h2 { margin: 12px 0 16px; font-family: var(--serif); font-weight: 400; font-size: 56px; letter-spacing: -.02em; line-height: 1; }
  .blurb { margin: 0 0 24px; font-size: 18px; line-height: 1.55; color: var(--ink-2); }
  .btn-dark { display: inline-flex; align-items: center; min-height: 52px; padding: 0 24px; border-radius: 999px; background: var(--ink); color: var(--surface); text-decoration: none; font-weight: 700; }
  .btn-dark:hover { color: var(--surface); background: #000; }
  .term { flex: 1 1 360px; min-width: 0; background: var(--ink); color: var(--surface); border-radius: 20px; padding: 24px; font-family: var(--mono); font-size: 14px; line-height: 1.8; }
  .dots { display: flex; gap: 6px; margin-bottom: 16px; }
  .dots span { width: 12px; height: 12px; border-radius: 50%; background: var(--muted); }
  .term .prompt { color: #E9E4D2; }
  .term .dim { color: #B8B3A8; }

  .sec-h { margin: 12px 0 8px; font-family: var(--serif); font-weight: 400; font-size: 56px; letter-spacing: -.02em; }
  .sec-intro { margin: 0 0 28px; font-size: 18px; line-height: 1.55; color: var(--ink-2); max-width: 680px; }
  .dj-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 16px; }
  .dj { display: flex; flex-direction: column; gap: 12px; padding: 28px; border-radius: 24px; background: var(--surface); border: 1px solid var(--line); color: var(--ink); text-decoration: none; transition: transform .2s ease, box-shadow .2s ease; }
  .dj:hover { transform: translateY(-4px); box-shadow: 0 14px 32px rgba(30, 28, 24, .12); color: var(--ink); }
  .dj-tag { align-self: flex-start; padding: 4px 12px; border-radius: 999px; font-size: 13px; font-weight: 600; background: var(--t-made); color: #3B5670; }
  .dj-title { font-size: 30px; font-weight: 900; letter-spacing: -.02em; }
  .dj-blurb { font-size: 16px; line-height: 1.5; color: var(--ink-2); }
  .dj-go { margin-top: auto; color: var(--accent); font-weight: 700; }

  @media (max-width: 760px) {
    .panel { padding: 32px; }
    .panel-text h2, .sec-h { font-size: 40px; }
  }
  @media (prefers-reduced-motion: reduce) { .dj { transition: none; } }
</style>
