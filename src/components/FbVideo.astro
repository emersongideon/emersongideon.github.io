---
interface Props {
  /** Full Facebook video URL. */
  href: string;
  title: string;
}
const { href, title } = Astro.props;
const src = `https://www.facebook.com/plugins/video.php?href=${encodeURIComponent(href)}&show_text=false`;
---

<!-- Click-to-load Facebook video: nothing loads until the user asks for it. -->
<div class="fbv" data-src={src} data-title={title}>
  <button type="button" class="fbv-btn" aria-label={`Play video: ${title}`}>
    <span class="fbv-play" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z" /></svg>
    </span>
    <span class="fbv-cap">Play video</span>
  </button>
</div>

<style>
  .fbv { position: relative; aspect-ratio: 16 / 9; border-radius: 14px; overflow: hidden; background: var(--dark); }
  .fbv-btn { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; background: none; color: var(--dark-ink); cursor: pointer; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 10px; }
  .fbv-play { display: inline-flex; align-items: center; justify-content: center; width: 56px; height: 56px; border-radius: 50%; background: rgba(255, 255, 255, .14); }
  .fbv-play svg { width: 26px; height: 26px; margin-left: 2px; }
  .fbv-btn:hover .fbv-play { background: rgba(255, 255, 255, .24); }
  .fbv-cap { font-family: var(--mono); font-size: 12px; letter-spacing: .04em; }
  .fbv :global(iframe) { width: 100%; height: 100%; border: 0; display: block; }
</style>

<script>
  document.querySelectorAll<HTMLElement>('.fbv').forEach((el) => {
    el.querySelector('.fbv-btn')?.addEventListener('click', () => {
      const iframe = document.createElement('iframe');
      iframe.src = `${el.dataset.src}&autoplay=1`;
      iframe.title = el.dataset.title ?? 'Facebook video';
      iframe.allow = 'autoplay; clipboard-write; encrypted-media; picture-in-picture; web-share';
      iframe.allowFullscreen = true;
      el.replaceChildren(iframe);
    });
  });
</script>
