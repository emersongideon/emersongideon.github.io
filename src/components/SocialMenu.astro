const icon = (label: string) => {
  const p = paths[label.toLowerCase()];
  return p ? `<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="${p}"/></svg>` : label;
};
---

<div class="social-menu" data-open="false">
  <button type="button" class="sm-trigger" aria-haspopup="true" aria-expanded="false" aria-controls="sm-pop">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
    <span class="sm-label">Reach me</span>
  </button>
  <div class="sm-pop" id="sm-pop" role="menu" aria-label="Reach me by">
    {
      social.channels.map((c) => (
        <a
          role="menuitem"
          href={c.href}
          aria-label={c.label}
          target={c.href.startsWith('http') ? '_blank' : undefined}
          rel={c.href.startsWith('http') ? 'noopener noreferrer' : undefined}
        >
          <span class="sm-ic" set:html={icon(c.label)} />
          <span class="sm-name">{c.label}</span>
        </a>
      ))
    }
  </div>
</div>

<style>
  .social-menu { position: relative; }
  .sm-trigger {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    padding: 0 16px;
    border-radius: 999px;
    border: 2px solid var(--ink);
    background: transparent;
    color: var(--ink);
    font: inherit;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
  }
  .sm-trigger svg { width: 18px; height: 18px; }
  .sm-trigger:hover,
  .social-menu[data-open='true'] .sm-trigger { background: var(--ink); color: var(--surface); }

  .sm-pop {
    position: absolute;
    right: 0;
    top: calc(100% + 8px);
    z-index: 30;
    min-width: 200px;
    padding: 8px;
    border-radius: 16px;
    background: var(--surface);
    border: 1px solid var(--line);
    box-shadow: 0 16px 36px rgba(30, 28, 24, .14);
    display: grid;
    gap: 2px;
    opacity: 0;
    transform: translateY(-6px);
    pointer-events: none;
    transition: opacity .18s ease, transform .18s ease;
  }
  .social-menu:hover .sm-pop,
  .social-menu:focus-within .sm-pop,
  .social-menu[data-open='true'] .sm-pop {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }
  /* hover bridge so the pointer can travel from trigger to popover */
  .sm-pop::before { content: ''; position: absolute; left: 0; right: 0; top: -8px; height: 8px; }

  .sm-pop a {
    display: flex;
    align-items: center;
    gap: 12px;
    min-height: 44px;
    padding: 0 12px;
    border-radius: 10px;
    color: var(--ink);
    text-decoration: none;
    font-size: 15px;
    font-weight: 600;
  }
  .sm-pop a:hover { background: var(--bg); color: var(--ink); }
  .sm-ic { display: inline-flex; color: var(--muted); }
  .sm-pop a:hover .sm-ic { color: var(--accent); }
  .sm-ic :global(svg) { width: 20px; height: 20px; display: block; }

  @media (prefers-reduced-motion: reduce) {
    .sm-pop { transition: none; }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('.social-menu').forEach((menu) => {
    const trigger = menu.querySelector<HTMLButtonElement>('.sm-trigger')!;
    const setOpen = (open: boolean) => {
      menu.dataset.open = String(open);
      trigger.setAttribute('aria-expanded', String(open));
    };
    trigger.addEventListener('click', () => setOpen(menu.dataset.open !== 'true'));
    document.addEventListener('click', (e) => {
      if (!menu.contains(e.target as Node)) setOpen(false);
    });
    menu.addEventListener('keydown', (e) => {
      if ((e as KeyboardEvent).key === 'Escape') { setOpen(false); trigger.focus(); }
    });
  });
</script>
